# --- Python Virtual Environments ---
.venv/
.venv*/
venv/
env/
ENV/
env.bak/
venv.bak/
**/.venv/
**/venv/

# --- Python Bytecode & Caches ---
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist-info/
eggs/
.eggs/

# --- Node & Framework Dependencies ---
node_modules/
**/node_modules/
dist/
**/dist/
build/
.next/
coverage/

# --- Environment & Secret Credentials ---
.env
.env.*
!.env.example
aigaragebackend/.env

# --- Datasets & Heavy Artifacts ---
datasets/
**/datasets/
*.csv
*.parquet
*.sqlite3
*.db

# --- Logs & Runtime ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Operating System & Editor Files ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
